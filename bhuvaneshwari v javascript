<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple JavaScript Program</title>
</head>
<body>

    <h1>Welcome to My JavaScript Page</h1>

    <p id="message">This is the original text.</p>

    <button onclick="changeText()">Click me to change text!</button>

    <script>
        // JavaScript function to change the text of the paragraph
        function changeText() {
            document.getElementById("message").innerHTML = "The text has been changed!";
            alert("You clicked the button!");
}
</script>
</body>
</html>
